generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum ComponentStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  DECLINED
}

enum ModerationDecision {
  APPROVED
  DECLINED
}

enum ComponentAccessType {
  FREE
  PREMIUM
}

enum RevisionMediaType {
  IMAGE
  VIDEO
}

model User {
  id                 String              @id @default(cuid())
  name               String?
  email              String?             @unique
  emailVerified      DateTime?
  image              String?
  profileSlug        String?             @unique
  role               UserRole            @default(USER)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  accounts           Account[]
  sessions           Session[]
  ownedComponents    Component[]
  reviewedRevisions  ComponentRevision[] @relation("RevisionReviewer")
  moderationLogs     ModerationLog[]     @relation("ModerationActor")
  favorites          Favorite[]
  apiKeys            ApiKey[]
  purchases          ComponentPurchase[] @relation("BuyerPurchases")
  sales              ComponentPurchase[] @relation("SellerPurchases")
  platformConfigs    PlatformConfig[]    @relation("PlatformConfigUpdater")

  @@index([role])
}

model ApiKey {
  id          String   @id @default(cuid())
  userId      String
  name        String
  keyHash     String   @unique
  keyPrefix   String
  canPurchase Boolean  @default(false)
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Category {
  id          String      @id @default(cuid())
  name        String      @unique
  slug        String      @unique
  description String
  accent      String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  translations CategoryTranslation[]
  componentLinks ComponentCategory[]
  primaryForComponents Component[] @relation("PrimaryCategory")
}

model CategoryTranslation {
  id          String   @id @default(cuid())
  categoryId  String
  locale      String
  name        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([locale])
}

model Component {
  id                 String             @id @default(cuid())
  slug               String             @unique
  ownerId            String
  primaryCategoryId  String
  status             ComponentStatus    @default(DRAFT)
  featured           Boolean            @default(false)
  favoritesCount     Int                @default(0)
  viewCount          Int                @default(0)
  activeRevisionId   String?
  approvedRevisionId String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  publishedAt        DateTime?
  owner              User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  primaryCategory    Category           @relation("PrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: Restrict)
  categoryLinks      ComponentCategory[]
  revisions          ComponentRevision[]
  favorites          Favorite[]
  purchases          ComponentPurchase[]
  activeRevision     ComponentRevision? @relation("ActiveRevision", fields: [activeRevisionId], references: [id], onDelete: SetNull)
  approvedRevision   ComponentRevision? @relation("ApprovedRevision", fields: [approvedRevisionId], references: [id], onDelete: SetNull)

  @@index([primaryCategoryId])
  @@index([ownerId])
  @@index([status])
  @@index([publishedAt])
}

model ComponentCategory {
  componentId String
  categoryId  String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([componentId, categoryId])
  @@index([categoryId, sortOrder])
}

model ComponentRevision {
  id                    String             @id @default(cuid())
  componentId           String
  version               Int
  title                 String
  summary               String
  description           String
  swiftCode             String
  changelog             String?
  accessType            ComponentAccessType @default(FREE)
  sellerTargetPriceCents Int?
  status                ComponentStatus    @default(DRAFT)
  reviewNote            String?
  submittedAt           DateTime?
  reviewedAt            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  reviewerId            String?
  component             Component          @relation(fields: [componentId], references: [id], onDelete: Cascade)
  reviewer              User?              @relation("RevisionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  screenshots           RevisionScreenshot[]
  moderationLogs        ModerationLog[]
  purchases             ComponentPurchase[]
  activeForComponents   Component[]        @relation("ActiveRevision")
  approvedForComponents Component[]        @relation("ApprovedRevision")

  @@unique([componentId, version])
  @@index([componentId, status])
  @@index([reviewerId])
}

model RevisionScreenshot {
  id                 String            @id @default(cuid())
  revisionId         String
  mediaType          RevisionMediaType @default(IMAGE)
  mimeType           String?
  url                String
  storagePath        String
  previewUrl         String?
  previewStoragePath String?
  altText            String
  sortOrder          Int               @default(0)
  createdAt          DateTime          @default(now())
  revision           ComponentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([revisionId, sortOrder])
}

model ModerationLog {
  id          String             @id @default(cuid())
  revisionId  String
  moderatorId String
  decision    ModerationDecision
  note        String?
  createdAt   DateTime           @default(now())
  revision    ComponentRevision  @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  moderator   User               @relation("ModerationActor", fields: [moderatorId], references: [id], onDelete: Cascade)

  @@index([revisionId])
  @@index([moderatorId])
}

model Favorite {
  id          String    @id @default(cuid())
  componentId String
  userId      String
  createdAt   DateTime  @default(now())
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([componentId, userId])
  @@index([userId])
}

model ComponentPurchase {
  id                    String            @id @default(cuid())
  componentId           String
  buyerId               String
  sellerId              String
  approvedRevisionId    String
  sellerTargetPriceCents Int
  platformMarkupPercent Int
  platformFeeCents      Int
  salePriceCents        Int
  createdAt             DateTime          @default(now())
  component             Component         @relation(fields: [componentId], references: [id], onDelete: Cascade)
  buyer                 User              @relation("BuyerPurchases", fields: [buyerId], references: [id], onDelete: Cascade)
  seller                User              @relation("SellerPurchases", fields: [sellerId], references: [id], onDelete: Cascade)
  approvedRevision      ComponentRevision @relation(fields: [approvedRevisionId], references: [id], onDelete: Restrict)

  @@unique([componentId, buyerId])
  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
}

model PlatformConfig {
  id                   Int      @id
  premiumMarkupPercent Int      @default(35)
  updatedAt            DateTime @updatedAt
  updatedById          String?
  updatedBy            User?    @relation("PlatformConfigUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}
