{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "title",
    "summary",
    "description",
    "appName",
    "appStoreSearchHint",
    "rationale",
    "codeFilePath",
    "states",
    "selfReview"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "minLength": 40,
      "maxLength": 1400
    },
    "appName": {
      "type": "string",
      "minLength": 1
    },
    "appStoreSearchHint": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 20
    },
    "codeFilePath": {
      "type": "string",
      "minLength": 1
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "name",
          "appearance",
          "description",
          "rawScreenshotPath"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "appearance": {
            "type": "string",
            "enum": ["light", "dark"]
          },
          "description": {
            "type": "string",
            "minLength": 3
          },
          "rawScreenshotPath": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "selfReview": {
      "type": "object",
      "required": ["appealing", "visibleComponent", "notes"],
      "additionalProperties": false,
      "properties": {
        "appealing": {
          "type": "boolean"
        },
        "visibleComponent": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "minLength": 10
        }
      }
    }
  }
}
