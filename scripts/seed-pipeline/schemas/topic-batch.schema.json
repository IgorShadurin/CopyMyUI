{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["categoryName", "categorySlug", "generatedAt", "topics"],
  "additionalProperties": false,
  "properties": {
    "categoryName": {
      "type": "string",
      "minLength": 1
    },
    "categorySlug": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "titleHint",
          "appName",
          "rationale",
          "targetUserValue",
          "appStoreSearchHint",
          "differentiator",
          "states"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "titleHint": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80
          },
          "appName": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 20
          },
          "targetUserValue": {
            "type": "string",
            "minLength": 20
          },
          "appStoreSearchHint": {
            "type": "string",
            "minLength": 1
          },
          "differentiator": {
            "type": "string",
            "minLength": 10
          },
          "states": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 2
            }
          }
        }
      }
    }
  }
}
