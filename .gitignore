# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
.idea

# next.js
/.next/
/.tmp/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime uploads
/public/uploads

# generated seed pipeline runtime artifacts
/prisma/generated-seed/logs
/prisma/generated-seed/work
